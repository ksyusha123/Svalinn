{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Svalinn": {
    "Enabled": true,
    "MaxConcurrentRequests": 4,
    "MinimumPriorityWhenOverloaded": "High",
    "AlwaysAllowCriticalRequests": true,
    "RetryAfterSeconds": 2,
    "Strategy": "Inflight",
    "Cpu": {
      "SampleIntervalMs": 250,
      "SmoothingFactor": 0.3,
      "OverloadThresholdPercent": 90,
      "RecoveryThresholdPercent": 75,
      "ProcessorCapacity": null
    },
    "Cinnamon": {
      "InitialLimit": 4,
      "MinLimit": 1,
      "MaxLimit": 4,
      "QueueCapacity": 4,
      "QueueTimeoutMs": 250,
      "EnablePi": true,
      "EnableAutoTuner": true
    },
    "Adaptive": {
      "InitialLimit": 4,
      "MinLimit": 1,
      "MaxLimit": 4,
      "UpdateIntervalMs": 500,
      "MinSamples": 30,
      "ProbeIntervalMs": 60000,
      "EnablePriorityBorrowing": true,
      "PriorityDemandWindowMs": 500,
      "ReferenceWindowCount": 3,
      "ConsecutiveSlowWindows": 2,
      "MinLatencyIncreaseMs": 40,
      "ProbeMinSamples": 10,
      "ProbeMaxDurationMs": 2000
    }
  },
  "AllowedHosts": "*",
  "DelayBenchmark": {
    "CriticalDelayMs": 800,
    "HighDelayMs": 1600,
    "NormalDelayMs": 800,
    "LowDelayMs": 3000,
    "Slo": {
      "CriticalAvailability": "99.9%",
      "HighAvailability": "99%",
      "NormalAvailability": "best effort during overload",
      "LowAvailability": "may be shed first during overload",
      "CriticalP95LatencyMs": 1200,
      "HighP95LatencyMs": 2500
    }
  }
}
