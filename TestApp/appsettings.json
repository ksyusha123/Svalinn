{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Svalinn": {
    "Enabled": true,
    "MaxConcurrentRequests": 32,
    "MinimumPriorityWhenOverloaded": "High",
    "AlwaysAllowCriticalRequests": true,
    "RetryAfterSeconds": 2
  },
  "HospitalBenchmark": {
    "DefaultDelayMs": 25,
    "ReportsDelayMs": 250,
    "EmergencyDelayMs": 40
  },
  "AllowedHosts": "*"
}
